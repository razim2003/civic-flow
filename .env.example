# Placeholder values only. Copy to .env.local when application setup begins.
# All VITE_* values are public and will be included in the browser bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# The initial browser app needs no secret key or database password.
# Never add a Supabase secret/service-role key or database URL to VITE_*.
# Privileged operations use authenticated database functions, not browser secrets.
# Future CLI/CI credentials belong in local tooling or protected CI secrets.
